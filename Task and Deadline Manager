// ============================================================
// 2. MODEL: Task
// ============================================================
// Describes one task: title, course, type, priority, description,
// due date, completed or not, progress percentage.
class Task {
  final String id, title, courseCode, type, priority, description;
  final DateTime dueDate;
  final bool isCompleted;
  final int progress;

  Task({
    required this.id,
    required this.title,
    required this.courseCode,
    required this.type,
    required this.priority,
    required this.description,
    required this.dueDate,
    this.isCompleted = false,
    this.progress = 0,
  });

  // Getter: full days left from today until the due date. Used as task.daysLeft
  int get daysLeft {
    final now = DateTime.now();
    final today = DateTime(now.year, now.month, now.day);
    return DateTime(dueDate.year, dueDate.month, dueDate.day)
        .difference(today)
        .inDays;
  }

}

